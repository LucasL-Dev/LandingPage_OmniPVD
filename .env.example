# Apenas no servidor. Nunca adicionar a chave real ao Git.
STRIPE_SECRET_KEY=sk_test_...
# Price recorrente em BRL, R$ 79,90; confirmar periodicidade no Dashboard.
STRIPE_PRICE_ID=price_1UVCotRyOKs2Cpl0wvQXsmAi
DOMAIN=https://mediumslateblue-falcon-614408.hostingersite.com

# Integração opcional de webhook/fila. Node.js 24 e disco persistente, instância única.
# Valores privados: preencher apenas no servidor. Nada é enviado com as flags false.
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM=
SUPPORT_EMAIL=
AUTO_WELCOME_EMAIL_ENABLED=false
PRIVATE_DOWNLOAD_ENABLED=false
# Caminhos absolutos FORA do checkout/public_html. Deixe vazio até configurar o volume.
BILLING_DB_PATH=
PRIVATE_INSTALLER_PATH=
# Origem HTTPS real que atende /api/download (sem caminho ou barra extra).
DOWNLOAD_ORIGIN=

# Fase A: autenticação e licença. Opt-in; não altera Checkout/billing quando false.
AUTH_ENABLED=false
# Origem sem barra final; use um domínio estável para não perder as passkeys.
AUTH_ORIGIN=
# Host exato da origem, sem protocolo ou porta.
AUTH_RP_ID=
# Apenas desenvolvimento HTTP localhost. Em produção manter false.
AUTH_ALLOW_LOCALHOST=false
AUTH_ACCESS_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_BROWSER_TTL_SECONDS=43200
# PEM Ed25519 privado, fora do checkout. Nunca adicionar conteúdo ao .env.example.
LICENSE_PRIVATE_KEY_PATH=
LICENSE_SIGNING_KEY_ID=phase-a-1
LICENSE_OFFLINE_TTL_SECONDS=14400
LICENSE_RECHECK_SECONDS=900

# VPS deployment: see ops/backend.env.example and docs/DEPLOY-UBUNTU.md.
DEPLOY_ENV=development
HOST=127.0.0.1
PORT=3000
QUEUE_INTERVAL_SECONDS=30
MAX_CONCURRENT_DOWNLOADS=4
MAX_INSTALLER_BYTES=2147483648
BACKUP_DIR=
LICENSE_PREVIOUS_PUBLIC_KEYS_PATH=
