# Install as /etc/omnipdv/backend.env, root:root 0600. No real secrets in Git.
# systemd EnvironmentFile syntax: no export, commands, or variable expansion.
DEPLOY_ENV=production
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DOMAIN=https://pdv.example.com
STRIPE_SECRET_KEY=sk_test_REPLACE_PRIVATELY
STRIPE_PRICE_ID=price_REPLACE_TEST_PRICE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_TEST_ENDPOINT
BILLING_DB_PATH=/var/lib/omnipdv/billing.sqlite
AUTH_ENABLED=true
AUTH_ORIGIN=https://pdv.example.com
AUTH_RP_ID=pdv.example.com
AUTH_ALLOW_LOCALHOST=false
AUTH_ACCESS_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_BROWSER_TTL_SECONDS=43200
LICENSE_PRIVATE_KEY_PATH=/srv/omnipdv-private/license-2026-01.pem
LICENSE_SIGNING_KEY_ID=phase-a-1
LICENSE_OFFLINE_TTL_SECONDS=14400
LICENSE_RECHECK_SECONDS=900
# Optional public-only JWKS for controlled key rotation (empty = none).
LICENSE_PREVIOUS_PUBLIC_KEYS_PATH=
AUTO_WELCOME_EMAIL_ENABLED=false
PRIVATE_DOWNLOAD_ENABLED=false
PRIVATE_INSTALLER_PATH=/srv/omnipdv-private/OmniPDV-Setup.exe
DOWNLOAD_ORIGIN=https://pdv.example.com
RESEND_API_KEY=
RESEND_FROM=
SUPPORT_EMAIL=
QUEUE_INTERVAL_SECONDS=30
MAX_CONCURRENT_DOWNLOADS=4
MAX_INSTALLER_BYTES=2147483648
BACKUP_DIR=/var/lib/omnipdv/backups
